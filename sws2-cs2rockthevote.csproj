<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>sws2-cs2rockthevote</AssemblyName>
    <RootNamespace>Sws2Cs2RockTheVote</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <PublishDir>$(OutputPath)publish/sws2-cs2rockthevote</PublishDir>
    <!-- The contract repositories are cloned into the workspace by CI; keep their
         sources out of this project's default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);sws2-cs2menus/**;sws2-cs2mapmanager/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="SwiftlyS2.CS2" Version="*" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Avoid the vulnerable transitive MySqlConnector version in current SwiftlyS2 releases. -->
    <PackageReference Include="MySqlConnector" Version="2.6.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <Sws2Cs2MenusContractsProject Condition="Exists('sws2-cs2menus/contracts/Sws2Cs2Menus.Contracts.csproj')">sws2-cs2menus/contracts/Sws2Cs2Menus.Contracts.csproj</Sws2Cs2MenusContractsProject>
    <Sws2Cs2MenusContractsProject Condition="'$(Sws2Cs2MenusContractsProject)' == ''">../sws2-cs2menus/contracts/Sws2Cs2Menus.Contracts.csproj</Sws2Cs2MenusContractsProject>
    <Sws2Cs2MapManagerContractsProject Condition="Exists('sws2-cs2mapmanager/contracts/Sws2Cs2MapManager.Contracts.csproj')">sws2-cs2mapmanager/contracts/Sws2Cs2MapManager.Contracts.csproj</Sws2Cs2MapManagerContractsProject>
    <Sws2Cs2MapManagerContractsProject Condition="'$(Sws2Cs2MapManagerContractsProject)' == ''">../sws2-cs2mapmanager/contracts/Sws2Cs2MapManager.Contracts.csproj</Sws2Cs2MapManagerContractsProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Sws2Cs2MenusContractsProject)" Private="false" />
    <ProjectReference Include="$(Sws2Cs2MapManagerContractsProject)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="resources/templates/**/*;resources/translations/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PrepareContracts">
    <MSBuild Projects="$(Sws2Cs2MenusContractsProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="MenuContractsTargetPath" />
    </MSBuild>
    <MSBuild Projects="$(Sws2Cs2MapManagerContractsProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="MapManagerContractsTargetPath" />
    </MSBuild>
    <MakeDir Directories="$(OutDir)resources/exports" />
    <Copy SourceFiles="@(MenuContractsTargetPath)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(MenuContractsTargetPath)" DestinationFolder="$(OutDir)resources/exports" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(OutDir)" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(OutDir)resources/exports" />
  </Target>

  <Target Name="CopyContracts" AfterTargets="Build" DependsOnTargets="PrepareContracts" />

  <Target Name="CreateZip" AfterTargets="Publish" DependsOnTargets="PrepareContracts">
    <MakeDir Directories="$(PublishDir)resources/exports" />
    <Copy SourceFiles="@(MenuContractsTargetPath)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(MenuContractsTargetPath)" DestinationFolder="$(PublishDir)resources/exports" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="@(MapManagerContractsTargetPath)" DestinationFolder="$(PublishDir)resources/exports" />
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>

</Project>
